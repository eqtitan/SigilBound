<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the Unity-independent game core and runs checks outside Unity.
       Folder ends in ~ so Unity ignores it. Run from the repo root: dotnet run with project path unity/Tests~ -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/Sigilbound/Core/**/*.cs" />
    <!-- The Unity compile check is its own project. -->
    <Compile Remove="CompileCheck/**" />
    <None Remove="CompileCheck/**" />
    <None Include="fixtures/*.json" CopyToOutputDirectory="PreserveNewest" LinkBase="fixtures" />
    <None Include="../Assets/StreamingAssets/Models/anims_ual.json" CopyToOutputDirectory="PreserveNewest" Link="fixtures/anims_ual.json" />
    <!-- Hero art pipeline checks (ArtTests.cs): the shipped CC0 models and the hero prompt data. -->
    <None Include="../Assets/StreamingAssets/Models/*.glb" CopyToOutputDirectory="PreserveNewest" LinkBase="fixtures/models" />
    <None Include="../../docs/sigilbound/art/heroes/hero-prompts.json" CopyToOutputDirectory="PreserveNewest" Link="fixtures/hero-prompts.json" Condition="Exists('../../docs/sigilbound/art/heroes/hero-prompts.json')" />
  </ItemGroup>
</Project>
